# --- Database -------------------------------------------------------------
# Local PostgreSQL connection string for the app role.
# Matches docker-compose.yml if you use the bundled container, or your own
# local Postgres. Example below uses role `scope` with database `scope`.
DATABASE_URL="postgresql://scope:scope_secret@localhost:5432/scope"

# --- Auth -----------------------------------------------------------------
# Secret used to sign the session cookie (HMAC-SHA-256). Generate a strong
# random value, e.g. `openssl rand -hex 32`. Keep it stable across restarts.
AUTH_SECRET="replace-with-a-long-random-string"

# --- Email (SMTP) ---------------------------------------------------------
# For Gmail: host smtp.gmail.com, port 465, SMTP_USER = your Gmail address,
# SMTP_PASS = a 16-character App Password (Google Account > Security > App
# passwords; 2-Step Verification must be on). EMAIL_FROM must be the same
# address (or an identity verified with the provider).
#
# Leave SMTP_USER/SMTP_PASS blank to run in development mode, where emails are
# printed to the server console with an "[email:dev]" prefix instead of being
# sent. Use `npm run email:test` to probe the connection before testing an
# OTP flow.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="SCOPE <you@gmail.com>"
# Set to "false" if your provider uses a self-signed certificate (rare).
# Set to "true" to keep a persistent connection pool for bulk resend runs.
SMTP_REJECT_UNAUTHORIZED="true"
SMTP_POOL="false"